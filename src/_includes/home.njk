---
layout: base.njk
---
<div class="header">
  <h1>{{ heading }}</h1>
  <div class="social-links">
    <a href="mailto:{{ links.email }}" target="_blank"><i class="fa fa-envelope"></i></a>
    <a href="{{ links.linkedin }}" target="_blank"><i class="fa fa-linkedin"></i></a>
    <a href="{{ links.github }}" target="_blank"><i class="fa fa-github"></i></a>
    <a href="resume.pdf" target="_blank">{Resume}</a>
  </div>
  <div class="row">
    <div class="photocolumn">
      {% if photos.length > 1 %}
      <img src="img/{{ photos[0] }}" alt="Me" class="photo-swap" data-photos="{% for p in photos %}img/{{ p }}{% if not loop.last %},{% endif %}{% endfor %}" tabindex="0" role="button" aria-label="Photo of me, click to see another">
      {% else %}
      <img src="img/{{ photos[0] }}" alt="Me">
      {% endif %}
      {% for email in emails %}
      <h3 style="margin-{{ 'bottom' if loop.first else 'top' }}: 0;">{{ email }}</h3>
      {% endfor %}
    </div>
    <div class="columnx2">
      {{ content | safe }}
    </div>
  </div>
</div>

<div class="topic-filter" role="group" aria-label="Filter research and projects by topic">
  <button type="button" class="active" data-topic="all" aria-pressed="true">All</button>
  {% for topic in collections.research | topicList(collections.projects) %}
  <button type="button" data-topic="{{ topic }}" aria-pressed="false">{{ topic }}</button>
  {% endfor %}
</div>

{% for section in [
  { id: "research", title: "Research", items: collections.research },
  { id: "projects", title: "Projects", items: collections.projects }
] %}
<div class="section" id="{{ section.id }}">
  <h1>{{ section.title }}</h1>
  {% for entry in section.items | sort(false, false, "data.order") %}
  <div class="research_project" data-topics="{{ entry.data.topics | join(',') }}">
    <div class="photocolumn">
      {% set item = entry.data %}
      {% include "media.njk" %}
    </div>
    <div class="columnx2">
      <h3>{{ entry.data.title }}</h3>
      {% if entry.data.topics %}
      <div class="topic-chips">
        {% for topic in entry.data.topics %}<button type="button" data-topic="{{ topic }}" aria-label="Show only {{ topic }}">{{ topic }}</button>{% if not loop.last %} · {% endif %}{% endfor %}
      </div>
      {% endif %}
      {{ entry.content | safe }}
    </div>
  </div>
  {% endfor %}
  <p class="topic-empty" hidden>No {{ section.title | lower }} for this topic yet.</p>
</div>
{% endfor %}

{% set gallery = collections.gallery | first %}
<div class="section" id="personal">
  <h1>{{ gallery.data.title }}</h1>
  {{ gallery.content | safe }}
  <div class="row">
    {% for column in gallery.data.photos | columns(4) %}
    <div class="column">
      {% for item in column %}
      {% include "media.njk" %}
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>
